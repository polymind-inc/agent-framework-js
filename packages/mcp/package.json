{
  "name": "@polymind-inc/agent-framework-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol client integration for the Agent Framework: MCP server tools as framework tools.",
  "keywords": [
    "agent",
    "ai",
    "llm",
    "agent-framework",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/polymind-inc/agent-framework-js/tree/master/packages/mcp#readme",
  "bugs": "https://github.com/polymind-inc/agent-framework-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymind-inc/agent-framework-js.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "author": "shibayan <me@shibayan.jp>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.config.json --noEmit"
  },
  "dependencies": {
    "@polymind-inc/agent-framework-core": "workspace:^",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
